# Long-cache fingerprint-safe static assets
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Always revalidate HTML so deploys show immediately (no stale cache)
# noindex until the domain cutover flips it off (matches sibling sites)
/*
  Cache-Control: public, max-age=0, must-revalidate
  X-Robots-Tag: noindex, nofollow
